{
  "name": "chain-skills-radar",
  "version": "3.0.0",
  "description": "Generate configurable radar-chart SVG cards for GitHub READMEs.",
  "type": "module",
  "bin": {
    "chain-skills-radar": "src/cli.mjs"
  },
  "scripts": {
    "generate": "node src/cli.mjs generate --config radar.json --output assets/radar.svg",
    "generate:square": "node src/cli.mjs generate --config examples/radar-square.json --output assets/radar-square.svg",
    "test": "node --test"
  },
  "keywords": [
    "github-readme",
    "radar-chart",
    "svg",
    "github-action"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
